{
  "app": "npx ts-node --prefer-ts-exts bin/app.ts",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "node_modules",
      "dist"
    ]
  },
  "context": {
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:validationReportJson": true,
    "@aws-cdk/customresources:installLatestAwsSdkDefault": false,
    "connectionArn": "arn:aws:codeconnections:ap-northeast-1:YOUR_AWS_ACCOUNT_ID:connection/c621477a-f8ed-42cd-a9b4-516eae4d755b"
  }
}
